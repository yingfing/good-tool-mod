{
	"schemaVersion": 1,
	"id": "good_tool_mod",
	"version": "${version}",
	"name": "Good Tool Mod",
	"description": "Server information display mod for Minecraft multiplayer servers",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/yingfing/good-tool-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/good_tool_mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		],
		"modmenu": [
			"com.example.client.config.ExampleModMenuIntegration"
		]
	},
	"mixins": [
		"good_tool_mod.mixins.json",
		{
			"config": "good_tool_mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.11",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
